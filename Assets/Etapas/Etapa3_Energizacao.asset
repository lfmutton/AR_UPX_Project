  m_Script: {fileID: 11500000, guid: 05d355e64e1e77d47a7c95b0833b60a0, type: 3}
  m_Name: Etapa3_Energizacao
  m_EditorClassIdentifier: Assembly-CSharp::Facens.WL01.InspectionStep
  title: "Energiza\xE7\xE3o / Bring UP"
  requirementId: RF03
  instruction: "Energize a placa com fonte de bancada com limite de corrente e observe
    os LEDs de diagn\xF3stico."
  cards:
  - title: LEDs
    text: '[preencher: LEDs e comportamento esperado]'
  - title: "Tens\xF5es"
    text: '[preencher: trilhos e faixas esperadas]'
  highlights:
  - label: 'LED PWR [preencher]'
    positionCm: {x: 9, y: 3}
    kind: 0
  - label: 'LED STATUS [preencher]'
    positionCm: {x: 9, y: -1}
    kind: 0
  - label: "Entrada de alimenta\xE7\xE3o"
    positionCm: {x: -9, y: -5}
    kind: 2
  checklist:
  - Fonte com limite de corrente configurado
  - LED PWR aceso
  measurements:
  - label: "Tens\xE3o no trilho de 5 V (exemplo)"
    unit: V
    hasRange: 1
    min: 4.75
    max: 5.25
  - label: 'Corrente consumida [preencher]'
    unit: mA
    hasRange: 0
    min: 0
    max: 0
  quiz:
  - question: Por que energizar a placa com uma fonte com limite de corrente?
    options:
    - "Para a placa ligar mais r\xE1pido"
    - Para limitar danos caso exista um curto
    - "Para aumentar a tens\xE3o de sa\xEDda"
    correctIndex: 1
